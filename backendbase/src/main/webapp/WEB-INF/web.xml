<?xml version="1.0" encoding="UTF-8"?>
<web-app metadata-complete="false" version="4.0" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee                               http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd">
    <display-name>SketchWeb</display-name>
    <servlet>
        <servlet-name>svLogIn</servlet-name>
        <servlet-class>Servlets.svLogIn</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet>
        <servlet-name>svGetProjects</servlet-name>
        <servlet-class>Servlets.svGetProjects</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>svCreateProject</servlet-name>
        <servlet-class>Servlets.svCreateProject</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>svUpdateProject</servlet-name>
        <servlet-class>Servlets.svUpdateProject</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>svLogIn</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>svGetProjects</servlet-name>
        <url-pattern>/getProjects</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>svCreateProject</servlet-name>
        <url-pattern>/createProject</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>svUpdateProject</servlet-name>
        <url-pattern>/updateProject</url-pattern>
    </servlet-mapping>
    
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>
    <filter>
        <filter-name>CorsFilter</filter-name>
        <filter-class>org.apache.catalina.filters.CorsFilter</filter-class>
        <init-param>
            <param-name>cors.allowed.origins</param-name>
            <param-value>*</param-value>
            <!-- Replace with your specific domain, e.g., https://example.com -->
        </init-param>
        <init-param>
            <param-name>cors.allowed.methods</param-name>
            <param-value>GET,POST,PUT,DELETE,OPTIONS</param-value>
        </init-param>
        <init-param>
            <param-name>cors.allowed.headers</param-name>
            <param-value>Content-Type,X-Requested-With,accept,Origin,Access-Control-Request-Method,Access-Control-Request-Headers</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>CorsFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
</web-app>
